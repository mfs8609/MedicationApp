<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/editor_root" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
  <LinearLayout android:id="@+id/editor_form" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
    <TextView android:id="@+id/editor_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/new_title" android:textSize="26sp" android:textStyle="bold" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/name_label" android:labelFor="@id/name" />
    <EditText android:id="@+id/name" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:inputType="textCapWords" android:importantForAutofill="no" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/strength_label" android:labelFor="@id/strength" />
    <EditText android:id="@+id/strength" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:inputType="text" android:importantForAutofill="no" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/quantity_label" android:labelFor="@id/quantity" />
    <EditText android:id="@+id/quantity" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:inputType="numberDecimal" android:importantForAutofill="no" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/unit_label" android:labelFor="@id/unit" />
    <EditText android:id="@+id/unit" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:inputType="text" android:importantForAutofill="no" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/notes_label" android:labelFor="@id/notes" />
    <EditText android:id="@+id/notes" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:inputType="textMultiLine|textCapSentences" android:importantForAutofill="no" />
    <CheckBox android:id="@+id/active" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/active_label" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/recurrence_label" />
    <Spinner android:id="@+id/recurrence" android:layout_width="match_parent" android:layout_height="48dp" android:entries="@array/recurrences" />
    <LinearLayout android:id="@+id/week_group" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
      <TextView android:id="@+id/week_error" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/weekdays_label" />
      <LinearLayout android:id="@+id/week_checks" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"></LinearLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/interval_group" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/interval_label" android:labelFor="@id/interval" />
      <EditText android:id="@+id/interval" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:inputType="number" android:importantForAutofill="no" />
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/start_label" android:labelFor="@id/start" />
    <EditText android:id="@+id/start" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:inputType="date" android:hint="@string/date_hint" android:importantForAutofill="no" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/end_label" android:labelFor="@id/end" />
    <EditText android:id="@+id/end" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:inputType="date" android:hint="@string/date_hint" android:importantForAutofill="no" />
    <TextView android:id="@+id/time_error" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/times_label" />
    <LinearLayout android:id="@+id/time_rows" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"></LinearLayout>
    <Button android:id="@+id/add_time" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/add_time" />
    <TextView android:id="@+id/editor_status" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <Button android:id="@+id/save" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/save" />
    <Button android:id="@+id/cancel" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/cancel" />
  </LinearLayout>
</ScrollView>
