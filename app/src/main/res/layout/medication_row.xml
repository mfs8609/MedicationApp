<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
  <TextView android:id="@+id/row_name" android:layout_width="match_parent" android:layout_height="wrap_content" />
  <TextView android:id="@+id/row_dose" android:layout_width="match_parent" android:layout_height="wrap_content" />
  <TextView android:id="@+id/row_schedule" android:layout_width="match_parent" android:layout_height="wrap_content" />
  <TextView android:id="@+id/row_next" android:layout_width="match_parent" android:layout_height="wrap_content" />
  <Button android:id="@+id/row_edit" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/edit" />
  <Button android:id="@+id/row_active" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/deactivate" />
</LinearLayout>